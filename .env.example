# Model
OPENAI_API_KEY=
ROCINANTE_MODEL=gpt-6-astra

# Kord. The 3D diff link needs NOTHING here -- /api/diff/share is anonymous
# and KORD_API_BASE already defaults to the public app.
KORD_API_BASE=https://work.withkord.com

# Only for review sessions, which need an authenticated session. Kord's REST
# API is cookie-session only (there is no bearer token), so this goes through
# /api/auth/demo-login -- which means the address must be in Kord's
# DEMO_LOGIN_EMAILS allowlist.
KORD_EMAIL=
KORD_PASSWORD=
KORD_PROJECT_ID=
KORD_FOLDER_ID=

# Toolchain paths
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
OPENROCKET_JAR=vendor/OpenRocket-23.09.jar
